diff --git a/tests/test_frnet_reproducibility_knobs.py b/tests/test_frnet_reproducibility_knobs.py
new file mode 100644
index 0000000..0c94673
--- /dev/null
+++ b/tests/test_frnet_reproducibility_knobs.py
@@ -0,0 +1,56 @@
+"""`--threads` and `--fast-scatter` on the device-path FRNet implementation.
+
+These two knobs come from `jp/p99-alloc-fixes` and exist for OPEN-ITEMS R-j: at
+PyTorch's default intra-op thread count FRNet's labels do not reproduce run to
+run, and at `torch.set_num_threads(1)` they are exact. They change how the model
+is BUILT, not how it is used, so the device seam (`semantic_pred=`,
+`semantics_from_prediction`) is untouched by them.
+
+`--fast-scatter` is host-only on purpose: the shim was verified bit-identical to
+the port's frustum loops on CPU at one thread and is unverified on the card,
+which is R-j's open GPU half.
+"""
+import pytest
+
+from vrgrid.run.__main__ import build_parser, iter_pipeline
+
+
+def test_both_flags_exist_and_default_off():
+    args = build_parser().parse_args([])
+    assert args.threads is None
+    assert args.fast_scatter is False
+
+
+def test_threads_and_fast_scatter_parse():
+    args = build_parser().parse_args(["--semantics", "frnet", "--threads", "1", "--fast-scatter"])
+    assert args.threads == 1 and args.fast_scatter is True
+    assert args.semantics == "frnet"
+
+
+def test_fast_scatter_is_refused_on_the_device_and_says_why():
+    """The guard must fire BEFORE the device is resolved.
+
+    Otherwise a machine with no card answers "no CUDA device", which is true and
+    not the reason: the combination is refused outright.
+    """
+    with pytest.raises(ValueError, match="host-only"):
+        next(iter_pipeline("08", 1, semantic_source="frnet",
+                           semantic_fast_scatter=True, device="cuda"))
+
+
+def test_fast_scatter_error_names_r_j():
+    with pytest.raises(ValueError, match="R-j"):
+        next(iter_pipeline("08", 1, semantic_source="frnet",
+                           semantic_fast_scatter=True, device="cuda"))
+
+
+@pytest.mark.parametrize("flag", [["--fast-scatter"], ["--threads", "1"]])
+def test_the_knobs_are_inert_without_the_dl_mode(flag):
+    """Parsed, but `main()` refuses them without `--semantics frnet`.
+
+    Pinned because the failure mode this project has hit twice is a flag that is
+    silently ignored on the path it does not apply to.
+    """
+    args = build_parser().parse_args(flag)
+    assert args.semantics == "gt"
+    assert args.fast_scatter or args.threads is not None
